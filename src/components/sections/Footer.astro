---
import Icon from "../Icon.astro";
---

<section>
    <footer class="w-full bg-white px-8 py-12 font-sans text-black">
  
  <div class="max-w-6xl mx-auto flex flex-col gap-8">
    
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-8">
      
      <div class="flex flex-wrap gap-4 w-40">
        <a href="https://www.facebook.com/luckyducky.studio" class="w-16 h-16 flex items-center justify-center border-2 border-gray-300 rounded-2xl hover:bg-gray-50 transition shadow-sm">
          <Icon name="facebook" class="w-8 h-8 text-black opacity-90 drop-shadow-md" />
        </a>
        <a href="" class="w-16 h-16 flex items-center justify-center border-2 border-gray-300 rounded-full hover:bg-gray-50 transition shadow-sm">
          <span class="text-2xl">🦆</span>
        </a>
        <a href="https://www.instagram.com/lduckystudio/" class="w-16 h-16 flex items-center justify-center border-2 border-gray-300 rounded-2xl hover:bg-gray-50 transition shadow-sm">
          <Icon name="instagram" class="w-8 h-8  text-black opacity-90 drop-shadow-md"/>
        </a>
        <a href="https://www.behance.net/LuckyDuckyStudio" class="w-16 h-16 flex items-center justify-center border-2 border-gray-300 rounded-2xl hover:bg-gray-50 transition shadow-sm">
          <Icon name="behance" class="w-8 h-8  text-black opacity-90 drop-shadow-md"/>
        </a>
      </div>

     <div class="w-full max-w-3xl border border-orange-200/60 rounded-[2.5rem] p-10 bg-white/70 backdrop-blur-md flex flex-col gap-10 shadow-sm relative overflow-hidden">

    <div class="w-full flex flex-row justify-between items-start">
        
        <div class="flex flex-col text-[#e94e1b] max-w-sm select-none">
            <h2 class="font-black text-6xl tracking-[0.08em] leading-none mb-1">
                UNA FRASE
            </h2>
            <h3 class="font-medium text-2xl tracking-widest leading-none mb-1">
                PERRONA, PERO LLAMATIVA
            </h3>
        </div>

        <nav class="flex flex-col gap-2 text-[#e94e1b] text-left font-black text-sm tracking-wider pt-1">
            <a href="#" class="hover:opacity-75 transition-opacity">INICIO</a>
            <a href="#" class="hover:opacity-75 transition-opacity">PROYECTOS</a>
            <a href="#" class="hover:opacity-75 transition-opacity">EQUIPO</a>
            <a href="#" class="hover:opacity-75 transition-opacity">CONTACTO</a>
        </nav>

    </div>

    <div class="w-full">
        <p class="text-[#e94e1b] text-sm font-semibold tracking-wide opacity-90">
            Dolores Hidalgo, Guanajuato, México.
        </p>
    </div>

    <div class="w-full text-center text-sm text-[#e94e1b]">
            <p>Diseñado por Lucky Ducky Studio™</p>
        </div>

</div>
</footer>
</section>
