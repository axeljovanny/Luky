---
import Icon from "../Icon.astro";
---

<section>
    <footer
        class="footer w-full h-[30vh] bg-blue-500 flex items-center justify-center"
    >
        <div class="container w-[100%] h-[80%] bg-amber-200">
            <div class="banner"></div>
            <div class="redes">
                <a
                    href="https://www.behance.net/LuckyDuckyStudio"
                    rel="noopener noreferrer"
                    target="_blank"
                    aria-label="Portafolio de Behance"
                    data-bubble="1"
                    class=""
                >
                    <Icon name="behance" class="w-12 h-12" />
                </a>
            </div>
            <div class="direccion"></div>
        </div>
    </footer>
</section>
