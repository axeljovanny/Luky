---
// Hero.astro
// Fondo líquido con morphing orgánico GSAP + textura de grano + burbujas glassmorphism.
import Icon from "../Icon.astro";
import { ui } from "../../i18n/ui";

// SSG: Asumimos por defecto 'es' en el servidor estático
const lang = "es";

// Textos SSR (Pre-compilados en español, el DOM luego cambia dinámicamente)
const typingPhrase = ui[lang]["hero.typingPhrase"];
const designedBy = ui[lang]["hero.designedBy"];
const brandName = ui[lang]["hero.brandName"];

// Serializar todos los textos al cliente para el cambio dinámico
const allTexts = JSON.stringify({
    es: {
        typingPhrase: ui["es"]["hero.typingPhrase"],
        designedBy: ui["es"]["hero.designedBy"],
        brandName: ui["es"]["hero.brandName"],
    },
    en: {
        typingPhrase: ui["en"]["hero.typingPhrase"],
        designedBy: ui["en"]["hero.designedBy"],
        brandName: ui["en"]["hero.brandName"],
    },
});
---

<section
    id="hero-section"
    data-phrase={typingPhrase}
    data-texts={allTexts}
    class="relative w-full h-dvh flex items-center justify-center p-0 md:p-0 overflow-hidden"
>
    {/* SVG de Filtro Artístico (Invisible) */}
    <svg class="absolute w-0 h-0 invisible" aria-hidden="true">
        <defs>
            <filter
                id="logo-grain"
                x="-20%"
                y="-20%"
                width="140%"
                height="140%"
            >
                <feTurbulence
                    type="fractalNoise"
                    baseFrequency="0.75"
                    numOctaves="2"
                    seed="2"
                    stitchTiles="stitch"
                    result="noise"></feTurbulence>
                <feComposite
                    operator="in"
                    in="noise"
                    in2="SourceGraphic"
                    result="masked-noise"></feComposite>
                <feColorMatrix
                    in="masked-noise"
                    type="saturate"
                    values="0"
                    result="desaturated-noise"></feColorMatrix>
                <feComponentTransfer
                    in="desaturated-noise"
                    result="controlled-noise"
                >
                    <!-- slope controla intensidad: 0.2 sutil, 0.5 fuerte -->
                    <feFuncA type="linear" slope="0.28" intercept="0"></feFuncA>
                </feComponentTransfer>
                <feBlend
                    in="SourceGraphic"
                    in2="controlled-noise"
                    mode="overlay"
                    result="grained-logo"></feBlend>
            </filter>
        </defs>
    </svg>

    {
        /* Contenedor Secundario UI: 90x90 en móvil, 80x80 en Web. Limita y enmarca las burbujas flotantes */
    }
    <div
        class="relative mx-auto w-[100vw] h-[100dvh] md:w-[84vw] md:h-[84dvh] xl:w-[88vw] xl:h-[88dvh] 2xl:w-[90vw] 2xl:h-[90dvh]"
    >
        {/* Capa UI (Cristales Interactivos) - No afectada por la máscara */}
        <div
            class="relative z-10 w-full h-full flex flex-col items-center justify-center p-6 sm:p-12 xl:p-16"
        >
            {/* Espacio reservado para Logo y Texto central */}
            <div
                class="flex-1 flex flex-col items-center justify-center w-full max-w-2xl xl:max-w-5xl 2xl:max-w-7xl text-center"
            >
                {/* Contenedor de Capas: Logo Móvil + Texto Superpuesto */}
                <div
                    class="relative flex items-center justify-center w-full max-w-[220px] xs:max-w-[270px] sm:max-w-[320px] md:hidden"
                >
                    <Icon
                        name="luky-logo"
                        class="block w-full mb-0 drop-shadow-[0_10px_25px_rgba(233,78,27,0.4)] cursor-pointer opacity-[0.93]"
                        style="filter: url(#logo-grain);"
                    />

                    {
                        /* Burbuja de Texto Estilo Consola (Superpuesta al centro) */
                    }
                    <div
                        class="glass-bubble-alt absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 flex items-center justify-center opacity-0 pointer-events-none z-30 scale-[0.65] xs:scale-75 sm:scale-100 min-w-max"
                        id="construction-bubble"
                    >
                        <span
                            id="typing-content"
                            class="text-[var(--color-text-primary)] transition-colors duration-400 font-mono text-[0.75rem] xs:text-[0.85rem] sm:text-[1.05rem] tracking-tight whitespace-pre font-bold"
                        ></span>
                        <span
                            class="console-cursor text-[var(--color-text-primary)] transition-colors duration-400"
                            >|</span
                        >
                    </div>
                </div>

                {/* Logo Completo para Desktop */}
                <div
                    class="relative hidden md:flex items-center justify-center w-full max-w-[620px] xl:max-w-[820px] 2xl:max-w-[1000px]"
                    id="desktop-logo"
                >
                    <Icon
                        name="logo-completo"
                        class="w-full drop-shadow-[0_10px_25px_rgba(233,78,27,0.35)] cursor-pointer opacity-0"
                        style="filter: url(#logo-grain);"
                    />

                    {
                        /* Burbuja de Texto Desktop (Superpuesta al logo completo) */
                    }
                    <div
                        class="glass-bubble-alt absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-0 pointer-events-none z-30 min-w-max"
                        id="construction-bubble-desktop"
                    >
                        <span
                            id="typing-content-desktop"
                            class="text-[var(--color-brand-primary)] transition-colors duration-400 font-mono text-[1.1rem] tracking-tight whitespace-pre font-bold"
                        ></span>
                        <span
                            class="console-cursor text-[var(--color-brand-primary)] transition-colors duration-400"
                            >|</span
                        >
                    </div>
                </div>

                {/* Aquí irá el glass input elástico */}
            </div>

            {/* Texto de firma */}
            <div
                class="absolute bottom-4 xs:bottom-6 sm:bottom-12 w-full text-center pointer-events-none"
            >
                <p
                    class="text-[var(--color-brand-secondary)] transition-colors duration-400 font-montserrat font-bold text-[0.65rem] xs:text-xs sm:text-sm xl:text-base 2xl:text-lg tracking-wide opacity-100"
                >
                    <span id="footer-designed-by">{designedBy}</span>
                    {" "}
                    <span
                        class="text-[var(--color-brand-accent)] transition-colors duration-400"
                        id="footer-brand">{brandName}</span
                    >&trade;
                </p>
            </div>

            {/* Burbujas de Redes Sociales */}

            {/* Burbuja Top Right (Facebook) */}
            <a
                href="https://www.facebook.com/luckyducky.studio"
                rel="noopener noreferrer"
                target="_blank"
                aria-label="Perfil de Facebook"
                data-bubble="0"
                class="glass-bubble top-10 -right-6 w-28 h-28 xs:w-36 xs:h-36 xs:top-12 xs:-right-10 sm:top-[8%] sm:right-[2%] sm:w-28 sm:h-28 xl:w-36 xl:h-36 xl:top-[6%] xl:right-[4%] 2xl:w-44 2xl:h-44 hover:scale-105 transition-all duration-400"
            >
                <Icon
                    name="facebook"
                    class="w-12 h-12 xs:w-16 xs:h-16 sm:w-12 sm:h-12 xl:w-16 xl:h-16 2xl:w-20 2xl:h-20 z-10 opacity-90 drop-shadow-md"
                />
            </a>

            {/* Burbuja Middle Left (behance) */}
            <a
                href="https://www.behance.net/LuckyDuckyStudio"
                rel="noopener noreferrer"
                target="_blank"
                aria-label="Portafolio de Behance"
                data-bubble="1"
                class="glass-bubble -left-8 top-[45%] w-28 h-28 xs:w-40 xs:h-40 xs:-left-12 sm:bottom-[35%] sm:top-auto sm:left-[2%] sm:w-36 sm:h-36 xl:w-44 xl:h-44 xl:left-[4%] 2xl:w-52 2xl:h-52 hover:scale-105 transition-all duration-400"
            >
                <Icon
                    name="behance"
                    class="w-12 h-12 xs:w-20 xs:h-20 sm:w-16 sm:h-16 xl:w-20 xl:h-20 2xl:w-24 2xl:h-24 z-10 opacity-90 drop-shadow-md"
                />
            </a>

            {/* Burbuja Bottom Right (Instagram) */}
            <a
                href="https://www.instagram.com/lduckystudio/"
                rel="noopener noreferrer"
                target="_blank"
                aria-label="Perfil de Instagram"
                data-bubble="2"
                class="glass-bubble -right-6 bottom-16 w-32 h-32 xs:w-40 xs:h-40 xs:-right-10 xs:bottom-16 sm:bottom-[12%] sm:right-[2%] sm:w-44 sm:h-44 xl:w-52 xl:h-52 xl:right-[4%] 2xl:w-60 2xl:h-60 hover:scale-105 transition-all duration-400"
            >
                <Icon
                    name="instagram"
                    class="w-14 h-14 xs:w-20 xs:h-20 sm:w-[4.4rem] sm:h-[4.4rem] xl:w-24 xl:h-24 2xl:w-28 2xl:h-28 z-10 opacity-90 drop-shadow-md"
                />
            </a>
        </div>
    </div>
</section>

<style is:global>
    /* Efecto Esfera de Cristal (Glassmorphism 3D) Máscristalino */
    .glass-bubble {
        position: absolute;
        border-radius: 50%;
        /* Cristal puro: Base casi completamente transparente */
        background: linear-gradient(
            135deg,
            rgba(255, 255, 255, 0.15) 0%,
            rgba(255, 255, 255, 0.02) 100%
        );
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);

        /* Borde exterior más rígido para enmarcar el "vidrio" */
        border: 1.5px solid rgba(255, 255, 255, 0.45);

        /* Combinación de sombras para profundidad 3D muy vívida */
        box-shadow:
            0 25px 45px -10px rgba(0, 0, 0, 0.15),
            /* Sombra proyectada exterior */ inset 0 4px 12px 1px
                rgba(255, 255, 255, 0.9),
            /* Borde de luz superior (Rim light) */ inset 0 -8px 20px 0
                rgba(255, 255, 255, 0.4),
            /* Reflejo de luz base (Ambient light inferior) */ inset 0 0
                15px -3px rgba(255, 255, 255, 0.2); /* Relleno tenue */

        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        z-index: 20;
        transition:
            background 0.4s ease,
            border-color 0.4s ease,
            box-shadow 0.4s ease,
            color 0.4s ease,
            transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
        color: #ffffff;
    }

    /* Reflejo esférico de luz directa tipo foco (glare) en la parte superior */
    .glass-bubble::before {
        content: "";
        position: absolute;
        top: 2%;
        left: 5%;
        width: 90%;
        height: 60%;
        border-radius: 50%;
        /* Difuminado radial para concentrar la luz en el pico y difuminarla hacia abajo */
        background: radial-gradient(
            ellipse at top,
            rgba(255, 255, 255, 0.8) 0%,
            rgba(255, 255, 255, 0) 65%
        );
        pointer-events: none;
        transition: background 0.4s ease;
    }

    /* Adaptación del burbuja a Modo Oscuro */
    .dark .glass-bubble {
        background: linear-gradient(
            135deg,
            rgba(10, 10, 10, 0.75) 0%,
            rgba(25, 25, 25, 0.35) 100%
        );
        border: 1.5px solid rgba(255, 255, 255, 0.04);
        box-shadow:
            0 25px 45px -10px rgba(0, 0, 0, 0.8),
            inset 0 4px 12px 1px rgba(255, 255, 255, 0.04),
            inset 0 -8px 20px 0 rgba(0, 0, 0, 0.8),
            inset 0 0 15px -3px rgba(0, 0, 0, 0.5);
        color: #000000;
    }

    .dark .glass-bubble::before {
        background: radial-gradient(
            ellipse at top,
            rgba(255, 255, 255, 0.04) 0%,
            rgba(255, 255, 255, 0) 65%
        );
    }

    /* Animación de Ciclo de Color para el Logo */
    @keyframes color-cycle {
        0%,
        100% {
            color: var(--color-brand-primary);
        } /* Principal */
        33% {
            color: var(--color-brand-secondary);
        } /* Secundario */
        66% {
            color: var(--color-brand-accent);
        } /* Acento */
    }

    .animate-color-cycle {
        color: var(--color-brand-primary); /* Fallback de seguridad */
        animation: color-cycle 60s infinite ease-in-out;
    }

    /* Variación Alargada para Texto de Consola */
    .glass-bubble-alt {
        display: inline-flex;
        align-items: center;
        padding: 0.7rem 1.6rem;
        border-radius: 2rem;
        background: rgba(255, 255, 255, 0.413);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.518);
        box-shadow:
            0 8px 32px 0 rgba(0, 0, 0, 0.15),
            inset 0 0 10px rgba(255, 255, 255, 0.1);
        margin-top: -1rem;
        transition:
            background 0.4s ease,
            border-color 0.4s ease,
            box-shadow 0.4s ease;
    }

    .dark .glass-bubble-alt {
        background: rgba(10, 10, 10, 0.75);
        border: 1px solid rgba(255, 255, 255, 0.04);
        box-shadow:
            0 8px 32px 0 rgba(0, 0, 0, 0.6),
            inset 0 0 10px rgba(0, 0, 0, 0.5);
    }

    .console-cursor {
        display: inline-block;
        margin-left: 2px;
        color: #ffffff;
        animation: cursor-blink 1s infinite step-end;
        font-weight: bold;
    }

    @keyframes cursor-blink {
        0%,
        100% {
            opacity: 1;
        }
        50% {
            opacity: 0;
        }
    }
</style>

<script>
    import gsap from "gsap";

    // ─── Textos i18n disponibles en cliente ───
    const sectionEl = document.getElementById("hero-section");
    const TEXTS = sectionEl ? JSON.parse(sectionEl.dataset.texts || "{}") : {};

    // Si el sitio fue cargado globalmente con un idioma no-default ('en'), iniciamos un switch reactuoso
    const initialLang = localStorage.getItem("lang") || "es";
    if (initialLang !== "es") {
        window.dispatchEvent(
            new CustomEvent("lang-change", { detail: { lang: initialLang } }),
        );
    }

    // ─── Lógica de Escritura (Typing Effect) ───
    let currentPhrase = sectionEl ? sectionEl.dataset.phrase || "" : "";
    let typingTween = null;

    // Móvil
    const bubble = document.getElementById("construction-bubble");
    const typingContent = document.getElementById("typing-content");

    // Desktop
    const bubbleDesktop = document.getElementById(
        "construction-bubble-desktop",
    );
    const typingContentDesktop = document.getElementById(
        "typing-content-desktop",
    );

    function setupTyping(
        bubbleEl: HTMLElement | null,
        typingEl: HTMLElement | null,
        delay: number,
    ) {
        if (!bubbleEl || !typingEl) return;

        gsap.to(bubbleEl, {
            opacity: 1,
            duration: 1,
            delay: delay,
            onComplete: () => {
                startTyping(typingEl);
            },
        });
    }

    function startTyping(typingEl: HTMLElement | null) {
        if (!typingEl) return;

        // Usar atributo local para aislar generaciones independientemente por burbuja
        const gen = parseInt(typingEl.dataset.gen || "0") + 1;
        typingEl.dataset.gen = gen.toString();

        typingEl.textContent = "";
        let i = 0;
        const typingSpeed = 0.05;
        const phrase = currentPhrase;

        const typeNext = () => {
            if (typingEl.dataset.gen !== gen.toString()) return; // Abortar si inició otra
            if (i < phrase.length && typingEl.textContent !== undefined) {
                typingEl.textContent += phrase[i];
                i++;
                gsap.delayedCall(typingSpeed, typeNext);
            }
        };
        typeNext();
    }

    // ─── Cambio de idioma dinámico ───
    window.addEventListener("lang-change", ((e: CustomEvent) => {
        const lang = e.detail.lang;
        const texts = TEXTS[lang];
        if (!texts) return;

        currentPhrase = texts.typingPhrase;

        // Actualizar footer
        const footerDesignedBy = document.getElementById("footer-designed-by");
        const footerBrand = document.getElementById("footer-brand");
        if (footerDesignedBy) footerDesignedBy.textContent = texts.designedBy;
        if (footerBrand) footerBrand.textContent = texts.brandName;

        // Reiniciar el efecto de typing en ambas burbujas
        if (typingContent) startTyping(typingContent);
        if (typingContentDesktop) startTyping(typingContentDesktop);
    }) as EventListener);

    // Activar en móvil
    setupTyping(bubble, typingContent, 0.5);
    // Activar en desktop (con un poco más de delay para que el logo entre primero)
    setupTyping(bubbleDesktop, typingContentDesktop, 2);

    // ─── Animación de Entrada del Logo Completo (Desktop) ───
    const desktopLogo = document.getElementById("desktop-logo");

    if (desktopLogo) {
        const logoSvg = desktopLogo.querySelector("svg");
        const topGroup = desktopLogo.querySelector(".logo-top");
        const bottomGroup = desktopLogo.querySelector(".logo-bottom");

        if (logoSvg && topGroup && bottomGroup) {
            // Timeline de entrada secuencial
            const tl = gsap.timeline({ delay: 0.3 });

            // Fade in del SVG completo
            tl.to(logoSvg, {
                opacity: 0.93,
                duration: 0.6,
                ease: "power2.out",
            });

            // Grupo superior baja desde arriba
            tl.from(
                topGroup,
                {
                    yPercent: -18,
                    opacity: 0,
                    duration: 1,
                    ease: "power3.out",
                },
                "-=0.4",
            );

            // Grupo inferior sube desde abajo
            tl.from(
                bottomGroup,
                {
                    yPercent: 18,
                    opacity: 0,
                    duration: 1,
                    ease: "power3.out",
                },
                "-=0.8",
            );
        }
    }

    // ─── Helper para valores aleatorios ───
    function rand(min: number, max: number) {
        return gsap.utils.random(min, max);
    }

    // ─── Animaciones Flotantes para las Burbujas de Redes Sociales ───
    const bubbles = document.querySelectorAll("[data-bubble]");

    bubbles.forEach((bubble, i) => {
        // Flotación sinusoidal continua
        gsap.to(bubble, {
            y: `${rand(-15, -25)}`,
            duration: rand(2.5, 4),
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
            delay: i * 0.4,
        });

        gsap.to(bubble, {
            x: `${rand(-8, 8)}`,
            duration: rand(3, 5),
            ease: "sine.inOut",
            yoyo: true,
            repeat: -1,
            delay: i * 0.3,
        });

        // Efecto de pulso al hover
        bubble.addEventListener("mouseenter", () => {
            gsap.to(bubble, {
                scale: 1.15,
                duration: 0.4,
                ease: "elastic.out(1, 0.4)",
            });
        });

        bubble.addEventListener("mouseleave", () => {
            gsap.to(bubble, {
                scale: 1,
                duration: 0.6,
                ease: "elastic.out(1, 0.5)",
            });
        });
    });
</script>
