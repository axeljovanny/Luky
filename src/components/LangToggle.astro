---
// src/components/LangToggle.astro
// ─── Botón flotante para cambiar ES ↔ EN (Operativo 100% en Cliente para SSG) ───
import { ui } from "../i18n/ui";

const defaultLang = "es";
const label = ui[defaultLang]["lang.label"];
const toggleText = ui[defaultLang]["lang.toggle"];
---

<button
    id="lang-toggle-btn"
    aria-label={label}
    title={label}
    data-next-lang="en"
    class="lang-toggle"
>
    <span class="lang-toggle__globe" aria-hidden="true">
        <!-- Globe icon inline SVG -->
        <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            width="18"
            height="18"
        >
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
            <path d="M2 12h20"></path>
        </svg>
    </span>
    <span class="lang-toggle__label" id="lang-label">{toggleText}</span>
</button>

<style>
    .lang-toggle {
        position: fixed;
        top: 1.25rem;
        left: 1.25rem;
        z-index: 9999;

        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.45rem 1rem 0.45rem 0.75rem;
        border-radius: 9999px;

        /* Glassmorphism */
        background: rgba(255, 255, 255, 0.35);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1.5px solid rgba(255, 255, 255, 0.6);
        box-shadow:
            0 4px 24px rgba(0, 0, 0, 0.1),
            inset 0 2px 6px rgba(255, 255, 255, 0.75);

        cursor: pointer;
        color: var(--color-brand-primary);
        font-family: "Montserrat", sans-serif;
        font-weight: 700;
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        transition:
            transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
            box-shadow 0.2s ease,
            background 0.2s ease,
            color 0.4s ease;

        /* Prevent text select on click */
        user-select: none;
        -webkit-user-select: none;
    }

    .lang-toggle:hover {
        transform: scale(1.07) translateY(-1px);
        background: rgba(255, 255, 255, 0.55);
        box-shadow:
            0 8px 32px rgba(0, 0, 0, 0.12),
            inset 0 2px 8px rgba(255, 255, 255, 0.9);
    }

    .lang-toggle:active {
        transform: scale(0.97);
    }

    .lang-toggle__globe {
        display: flex;
        align-items: center;
        opacity: 0.85;
    }

    .lang-toggle__label {
        transition: opacity 0.15s ease;
    }

    /* Animación de cambio de texto */
    .lang-toggle__label.switching {
        opacity: 0;
        transform: translateY(-4px);
    }

    /* Modo Oscuro */
    :global(.dark) .lang-toggle {
        background: rgba(10, 10, 10, 0.65);
        border: 1.5px solid rgba(255, 255, 255, 0.05);
        box-shadow:
            0 4px 24px rgba(0, 0, 0, 0.6),
            inset 0 2px 6px rgba(255, 255, 255, 0.04);
        color: var(--color-brand-primary);
    }

    :global(.dark) .lang-toggle:hover {
        background: rgba(25, 25, 25, 0.85);
        box-shadow:
            0 8px 32px rgba(0, 0, 0, 0.8),
            inset 0 2px 8px rgba(255, 255, 255, 0.08);
    }
</style>

<script>
    const btn = document.getElementById("lang-toggle-btn");
    const labelEl = document.getElementById("lang-label");

    if (btn && labelEl) {
        // Inicialización en cliente para evitar lecturas de servidor (Astro SSG)
        const storedLang = localStorage.getItem("lang") || "es";
        if (storedLang === "en") {
            labelEl.textContent = "ES";
            btn.setAttribute("aria-label", "Cambiar idioma");
            btn.setAttribute("title", "Cambiar idioma");
            btn.dataset.nextLang = "es";
        }

        btn.addEventListener("click", () => {
            const nextLang = btn.dataset.nextLang || "en";

            // Animación de salida
            labelEl.classList.add("switching");

            setTimeout(() => {
                // Instaurar preferencia con LocalStorage nativo
                localStorage.setItem("lang", nextLang);
                
                // Forzar atributo del head y disparar evento reactivo para todas partes de la página
                document.documentElement.lang = nextLang;
                window.dispatchEvent(
                    new CustomEvent("lang-change", { detail: { lang: nextLang } })
                );

                // Actualizar el UI del botón
                const currentLabel =
                    nextLang === "en"
                        ? { toggle: "ES", title: "Cambiar idioma" }
                        : { toggle: "EN", title: "Switch language" };

                labelEl.textContent = currentLabel.toggle;
                btn.setAttribute("aria-label", currentLabel.title);
                btn.setAttribute("title", currentLabel.title);
                btn.dataset.nextLang = nextLang === "en" ? "es" : "en";

                labelEl.classList.remove("switching");
            }, 150);
        });
    }
</script>
