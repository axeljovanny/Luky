---
// src/components/ThemeToggle.astro
// ─── Botón Switch para Modo Oscuro/Claro ───
---

<button
    id="theme-toggle-btn"
    aria-label="Toggle Dark Mode"
    title="Toggle Dark Mode"
    class="theme-toggle"
>
    <!-- Contenedor interno del switch -->
    <div class="theme-toggle__track">
        <!-- Indicador circular (Pill) -->
        <div class="theme-toggle__thumb">
            <!-- Icono Sol (Claro) -->
            <svg class="icon icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="5"></circle>
                <path d="M12 1v2M12 21v2M4.2 4.2l1.4 1.4M18.4 18.4l1.4 1.4M1 12h2M21 12h2M4.2 19.8l1.4-1.4M18.4 5.6l1.4-1.4"></path>
            </svg>
            <!-- Icono Luna (Oscuro) -->
            <svg class="icon icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
        </div>
    </div>
</button>

<style>
    .theme-toggle {
        position: fixed;
        top: 1.25rem;
        right: 1.25rem;
        z-index: 9999;
        
        background: transparent;
        border: none;
        padding: 0;
        cursor: pointer;
        outline: none;

        /* Prevent text select on click */
        user-select: none;
        -webkit-user-select: none;
    }

    /* Pista del Switch (Track) */
    .theme-toggle__track {
        display: flex;
        align-items: center;
        width: 3.8rem;
        height: 2rem;
        border-radius: 9999px;
        
        /* Glassmorphism base */
        background: rgba(255, 255, 255, 0.35);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1.5px solid rgba(255, 255, 255, 0.6);
        box-shadow:
            0 4px 24px rgba(0, 0, 0, 0.1),
            inset 0 2px 6px rgba(255, 255, 255, 0.75);
            
        transition: background 0.4s ease, border-color 0.4s ease;
        position: relative;
    }

    /* Track en modo oscuro */
    :global(.dark) .theme-toggle__track {
        background: rgba(0, 0, 0, 0.4);
        border-color: rgba(255, 255, 255, 0.15);
        box-shadow:
            0 4px 24px rgba(0, 0, 0, 0.3),
            inset 0 2px 6px rgba(0, 0, 0, 0.5);
    }

    /* Botón deslizable (Thumb) */
    .theme-toggle__thumb {
        position: absolute;
        left: 0.15rem;
        top: 0.15rem;
        width: 1.5rem;
        height: 1.5rem;
        border-radius: 50%;
        
        background: white;
        box-shadow: 0 2px 6px rgba(0,0,0,0.2);
        
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.4s ease;
    }

    /* Posición thumb modo oscuro */
    :global(.dark) .theme-toggle__thumb {
        transform: translateX(1.8rem);
        background: #1f1f1f;
        box-shadow: 0 2px 6px rgba(0,0,0,0.5);
    }

    /* Iconos */
    .icon {
        width: 0.9rem;
        height: 0.9rem;
        position: absolute;
        transition: opacity 0.3s ease, transform 0.3s ease;
    }

    .icon-sun {
        color: #e94e1b;
        opacity: 1;
        transform: scale(1);
    }

    .icon-moon {
        color: #d1d5db;
        opacity: 0;
        transform: scale(0.5) rotate(-45deg);
    }

    /* Iconos en modo oscuro */
    :global(.dark) .icon-sun {
        opacity: 0;
        transform: scale(0.5) rotate(45deg);
    }

    :global(.dark) .icon-moon {
        opacity: 1;
        transform: scale(1) rotate(0deg);
    }

    /* Hover simple track */
    .theme-toggle:hover .theme-toggle__track {
        transform: scale(1.05) translateY(-1px);
    }
</style>

<script is:inline>
    // Este script debe ser inline (sin module scopes cerrados) para vincular eventos de forma simple,
    // o podemos utilizar un listener al final que dependa de `document.documentElement`
    
    document.addEventListener("DOMContentLoaded", () => {
        const btn = document.getElementById("theme-toggle-btn");
        if (!btn) return;
        
        btn.addEventListener("click", () => {
            const root = document.documentElement;
            // Toggle de clase
            root.classList.toggle("dark");
            
            // Guardar en LS
            const isDark = root.classList.contains("dark");
            localStorage.setItem("theme", isDark ? "dark" : "light");
        });
    });
</script>
