---
// src/layouts/Layout.astro
import "../styles/global.css";
import Navigation from "../components/Navigation.astro";
import { ui } from "../i18n/ui";

interface Props {
    title?: string;
}

const { title } = Astro.props;

// SSG: Por defecto el sitio se compila estáticamente asumiendo español.
// Si el cliente tiene otro idioma configurado, el script inline lo cambia instantáneamente.
const defaultLang = "es";
const metaTitle = title ?? ui[defaultLang]["meta.title"];
const metaDescription = ui[defaultLang]["meta.description"];
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{metaTitle}</title>
        <meta name="description" content={metaDescription} />
        
        {/* Open Graph Meta Tags (Para previsualizaciones en Discord, WhatsApp, redes) */}
        <meta property="og:title" content={metaTitle} />
        <meta property="og:description" content={metaDescription} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:image" content={new URL('/og-image.jpg', Astro.url)} />
        <meta property="og:locale" content="es_ES" />
        
        {/* Twitter Card Meta Tags */}
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={metaTitle} />
        <meta name="twitter:description" content={metaDescription} />
        <meta name="twitter:image" content={new URL('/og-image.jpg', Astro.url)} />

        <link rel="canonical" href={Astro.url} />
        
        {/* Script en LÍNEA (Inline): Evita Flash of Unstyled Content (FOUC) e inicia configuraciones locales antes de renderizar el DOM */}
        <script is:inline>
            // 1. Restaurar Tema (Oscuro/Claro)
            if (
                localStorage.getItem("theme") === "dark" ||
                (!("theme" in localStorage) && window.matchMedia("(prefers-color-scheme: dark)").matches)
            ) {
                document.documentElement.classList.add("dark");
            } else {
                document.documentElement.classList.remove("dark");
            }

            // 2. Restaurar Idioma (Lang) del cliente en el DOM y Metadatos para evitar FOUC SEO
            const storedLang = localStorage.getItem("lang") || "es";
            if(storedLang !== "es") {
                document.documentElement.lang = storedLang;
            }
        </script>
    </head>
    <body class="min-h-screen bg-[var(--color-bg)] overflow-x-hidden text-[var(--color-brand-primary)]">
        <Navigation />
        <slot />
    </body>
</html>
