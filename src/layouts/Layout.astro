---
interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content="Lucky Ducky Studio - Diseño y desarrollo web creativo" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title}</title>
    </head>
    <body class="min-h-screen bg-[#f5efe9] overflow-x-hidden">
        <slot />
    </body>
</html>

<style is:global>
    @import "../styles/global.css";
</style>
