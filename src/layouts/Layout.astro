---
import "../styles/global.css";

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="description"
            content="Lucky Ducky Studio - Diseño y desarrollo web creativo"
        />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <!-- Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&family=Lato:wght@400;700&family=EB+Garamond:wght@400;700&family=Bitcount+Grid+Double:wght@100..900&display=swap" rel="stylesheet" />
        <title>{title}</title>
    </head>
    <body class="min-h-screen bg-[#f5efe9] overflow-x-hidden">
        <slot />
    </body>
</html>
