---
// src/layouts/Layout.astro
import "../styles/global.css";
import LangToggle from "../components/LangToggle.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { getLangFromCookie } from "../i18n/utils";
import { ui } from "../i18n/ui";

interface Props {
    title?: string;
}

const { title } = Astro.props;

const cookieHeader = Astro.request.headers.get("cookie");
const lang = getLangFromCookie(cookieHeader);
const metaTitle = title ?? ui[lang]["meta.title"];
const metaDescription = ui[lang]["meta.description"];
---

<!doctype html>
<html lang={lang}>
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={metaDescription} />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{metaTitle}</title>
        
        {/* Inline script to prevent Flash of Unstyled Content (FOUC) when loading the page */}
        <script is:inline>
            if (
                localStorage.getItem("theme") === "dark" ||
                (!("theme" in localStorage) && window.matchMedia("(prefers-color-scheme: dark)").matches)
            ) {
                document.documentElement.classList.add("dark");
            } else {
                document.documentElement.classList.remove("dark");
            }
        </script>
    </head>
    <body class="min-h-screen bg-[var(--color-bg)] overflow-x-hidden text-[var(--color-brand-primary)]">
        <LangToggle currentLang={lang} />
        <ThemeToggle />
        <slot />
    </body>
</html>
